# Copy to .env at the repository root. Fill in your own credentials locally.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ECOMMERCE_ROLE
SNOWFLAKE_WAREHOUSE=ECOMMERCE_WH
SNOWFLAKE_DATABASE=ECOMMERCE
SNOWFLAKE_RAW_SCHEMA=RAW
SNOWFLAKE_STAGING_SCHEMA=STAGING
SNOWFLAKE_STAGE=ECOMMERCE.RAW.STG_LANDING
SNOWFLAKE_FILE_FORMAT_PARQUET=ECOMMERCE.RAW.FF_PARQUET

# Optional alternative authentication for ingestion and dbt's prod target.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
