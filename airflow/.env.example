AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Generate once with cryptography.fernet.Fernet.generate_key().decode().
FERNET_KEY=
# Keep the JWT secret stable and identical across all Airflow components.
AIRFLOW__API_AUTH__JWT_SECRET=

# Email: whole-pipeline success and final task failure. Slack: final failure only.
PIPELINE_ALERT_EMAIL_ENABLED=false
PIPELINE_ALERT_SLACK_ENABLED=false
PIPELINE_ALERT_BASE_URL=http://localhost:8080
PIPELINE_ALERT_EMAIL_FROM=
PIPELINE_ALERT_EMAIL_TO=
PIPELINE_SMTP_HOST=smtp-relay.brevo.com
PIPELINE_SMTP_PORT=587
PIPELINE_SMTP_SECURITY=starttls
PIPELINE_SMTP_USERNAME=
PIPELINE_SMTP_PASSWORD=
PIPELINE_SLACK_WEBHOOK_URL=
